      "severity": "high",
      "reason": "Remote code execution"
    },
    {
      "pattern": "git\\s+push\\s+.*(--force|-f)",
      "severity": "high",
      "reason": "Can overwrite remote history"
    },
    {
      "pattern": "DROP\\s+TABLE",
      "severity": "critical",
      "reason": "Data destruction"
    },
    {
      "pattern": "chmod\\s+777",
